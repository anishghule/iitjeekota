{
  "$description": "Kota Stone and Brass: the single source of design values for iitjeekota.com. DTCG-style tokens ($value, $type, {alias}). Edit here, run `make tokens`, and every output (CSS, TypeScript, Python, 3D materials, logo, favicons, OG images, brand guide) follows.",

  "color": {
    "$type": "color",
    "$description": "Primitive palette. Components never use these directly; they use the surface roles below.",
    "ink": {
      "$description": "Near-black with the green-blue cast of wet Kota stone.",
      "1000": { "$value": "#030a0b", "$description": "Shadow colour" },
      "950": { "$value": "#0a1416" },
      "900": { "$value": "#0f1c1f" },
      "800": { "$value": "#162629" },
      "700": { "$value": "#1f3135" }
    },
    "stone": {
      "$description": "Kota stone greys with a teal undertone.",
      "600": { "$value": "#304649" },
      "500": { "$value": "#4e6668" },
      "400": { "$value": "#728888" },
      "300": { "$value": "#9daeac" },
      "200": { "$value": "#c4d0cd" },
      "100": { "$value": "#dde5e2" }
    },
    "chalk": {
      "$description": "Cool limestone off-white, like a whiteboard under a tube light.",
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f4f7f5" },
      "100": { "$value": "#e9eeeb" }
    },
    "brass": {
      "$description": "Medal brass, tuned to the official D-SAP medal: 300 is the medal's sand (#e6c296), hue and saturation of the other steps follow it. The one premium accent and, polished, the action colour on dark surfaces.",
      "800": { "$value": "#614224" },
      "700": { "$value": "#7d5731" },
      "600": { "$value": "#9f7241" },
      "500": { "$value": "#ba8e5e" },
      "400": { "$value": "#d1a675" },
      "300": { "$value": "#e6c296", "$description": "The medal's sand, sampled from the official logo" },
      "200": { "$value": "#f0dbc1" }
    },
    "river": {
      "$description": "Muted river blue. Map and the Kota to Pune route only.",
      "700": { "$value": "#275a72" },
      "500": { "$value": "#4b87a3" },
      "300": { "$value": "#8bb9ce" }
    },
    "ok": { "600": { "$value": "#2e7650" }, "300": { "$value": "#73c79a" } },
    "warn": { "600": { "$value": "#8a5d08" }, "300": { "$value": "#e3b055" } },
    "error": { "600": { "$value": "#a8382c" }, "300": { "$value": "#ee8b7c" } }
  },

  "surface": {
    "$type": "color",
    "$description": "Semantic roles. Each section of a page sits on one surface (data-surface=\"ink\" or \"chalk\"); components only use these roles.",
    "ink": {
      "bg": { "$value": "{color.ink.900}" },
      "bg-raised": { "$value": "{color.ink.800}" },
      "bg-sunken": { "$value": "{color.ink.950}" },
      "text": { "$value": "{color.chalk.100}" },
      "text-muted": { "$value": "{color.stone.300}" },
      "accent": { "$value": "{color.brass.400}", "$description": "Icons, large numerals, rules of light" },
      "accent-text": { "$value": "{color.brass.300}", "$description": "Brass used as readable text" },
      "action-bg": { "$value": "{color.brass.300}", "$description": "Primary call to action" },
      "action-bg-hover": { "$value": "{color.brass.200}" },
      "action-text": { "$value": "{color.ink.950}" },
      "focus": { "$value": "{color.chalk.50}" },
      "river": { "$value": "{color.river.300}" },
      "subject-physics": { "$value": "{color.river.300}", "$description": "Physics in the syllabus table, the test and the report" },
      "subject-chemistry": { "$value": "{color.stone.200}", "$description": "Chemistry" },
      "subject-maths": { "$value": "{color.brass.300}", "$description": "Mathematics" },
      "ok": { "$value": "{color.ok.300}" },
      "warn": { "$value": "{color.warn.300}" },
      "error": { "$value": "{color.error.300}" },
      "field-bg": { "$value": "{color.ink.950}" },
      "field-stroke": { "$value": "{color.stone.400}", "$description": "Form fields only. Cards never get strokes." },
      "icon-accent": { "$value": "{color.brass.400}" },
      "selection-bg": { "$value": "{color.brass.300}" },
      "selection-text": { "$value": "{color.ink.950}" }
    },
    "chalk": {
      "bg": { "$value": "{color.chalk.50}" },
      "bg-raised": { "$value": "{color.chalk.0}" },
      "bg-sunken": { "$value": "{color.chalk.100}" },
      "text": { "$value": "{color.ink.950}" },
      "text-muted": { "$value": "{color.stone.500}" },
      "accent": { "$value": "{color.brass.600}" },
      "accent-text": { "$value": "{color.brass.700}" },
      "action-bg": { "$value": "{color.ink.900}" },
      "action-bg-hover": { "$value": "{color.ink.700}" },
      "action-text": { "$value": "{color.chalk.50}" },
      "focus": { "$value": "{color.river.700}" },
      "river": { "$value": "{color.river.700}" },
      "subject-physics": { "$value": "{color.river.700}" },
      "subject-chemistry": { "$value": "{color.stone.600}" },
      "subject-maths": { "$value": "{color.brass.700}" },
      "ok": { "$value": "{color.ok.600}" },
      "warn": { "$value": "{color.warn.600}" },
      "error": { "$value": "{color.error.600}" },
      "field-bg": { "$value": "{color.chalk.0}" },
      "field-stroke": { "$value": "{color.stone.400}" },
      "icon-accent": { "$value": "{color.brass.600}" },
      "selection-bg": { "$value": "{color.brass.200}" },
      "selection-text": { "$value": "{color.ink.950}" }
    }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Depth comes from light and shadow, never from 1px borders. Each level is a list of layers; offsets and blur in px.",
    "ink": {
      "1": { "$value": [
        { "inset": true, "offsetX": 0, "offsetY": 1, "blur": 0, "spread": 0, "color": "{color.chalk.50}", "alpha": 0.05 },
        { "offsetX": 0, "offsetY": 1, "blur": 2, "spread": 0, "color": "{color.ink.1000}", "alpha": 0.4 },
        { "offsetX": 0, "offsetY": 6, "blur": 14, "spread": -6, "color": "{color.ink.1000}", "alpha": 0.5 }
      ] },
      "2": { "$value": [
        { "inset": true, "offsetX": 0, "offsetY": 1, "blur": 0, "spread": 0, "color": "{color.chalk.50}", "alpha": 0.06 },
        { "offsetX": 0, "offsetY": 2, "blur": 4, "spread": 0, "color": "{color.ink.1000}", "alpha": 0.35 },
        { "offsetX": 0, "offsetY": 14, "blur": 30, "spread": -10, "color": "{color.ink.1000}", "alpha": 0.6 }
      ] },
      "3": { "$value": [
        { "inset": true, "offsetX": 0, "offsetY": 1, "blur": 0, "spread": 0, "color": "{color.chalk.50}", "alpha": 0.07 },
        { "offsetX": 0, "offsetY": 4, "blur": 8, "spread": 0, "color": "{color.ink.1000}", "alpha": 0.3 },
        { "offsetX": 0, "offsetY": 26, "blur": 52, "spread": -14, "color": "{color.ink.1000}", "alpha": 0.65 }
      ] },
      "4": { "$value": [
        { "inset": true, "offsetX": 0, "offsetY": 1, "blur": 0, "spread": 0, "color": "{color.chalk.50}", "alpha": 0.08 },
        { "offsetX": 0, "offsetY": 8, "blur": 16, "spread": 0, "color": "{color.ink.1000}", "alpha": 0.3 },
        { "offsetX": 0, "offsetY": 44, "blur": 88, "spread": -22, "color": "{color.ink.1000}", "alpha": 0.72 }
      ] }
    },
    "chalk": {
      "1": { "$value": [
        { "offsetX": 0, "offsetY": 1, "blur": 2, "spread": 0, "color": "{color.ink.950}", "alpha": 0.08 },
        { "offsetX": 0, "offsetY": 3, "blur": 8, "spread": -3, "color": "{color.ink.950}", "alpha": 0.1 }
      ] },
      "2": { "$value": [
        { "offsetX": 0, "offsetY": 2, "blur": 4, "spread": 0, "color": "{color.ink.950}", "alpha": 0.06 },
        { "offsetX": 0, "offsetY": 12, "blur": 26, "spread": -10, "color": "{color.ink.950}", "alpha": 0.16 }
      ] },
      "3": { "$value": [
        { "offsetX": 0, "offsetY": 4, "blur": 8, "spread": 0, "color": "{color.ink.950}", "alpha": 0.06 },
        { "offsetX": 0, "offsetY": 24, "blur": 48, "spread": -16, "color": "{color.ink.950}", "alpha": 0.2 }
      ] },
      "4": { "$value": [
        { "offsetX": 0, "offsetY": 8, "blur": 16, "spread": 0, "color": "{color.ink.950}", "alpha": 0.06 },
        { "offsetX": 0, "offsetY": 40, "blur": 80, "spread": -22, "color": "{color.ink.950}", "alpha": 0.24 }
      ] }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Archivo", "Archivo Fallback", "Arial", "sans-serif"], "$description": "Headlines and big numerals. Wide and heavy." },
      "body": { "$value": ["Google Sans Flex", "Inter", "Arial", "sans-serif"], "$description": "Running text and UI. Inter is vendored as the web fallback." },
      "devanagari": { "$value": ["Mukta", "Kohinoor Devanagari", "Nirmala UI", "Noto Sans Devanagari", "sans-serif"], "$description": "Hindi and Marathi, headlines and text." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "heavy": { "$value": 800 }
    },
    "stretch": {
      "$type": "percentage",
      "display": { "$value": 112.5, "$description": "Archivo semi-expanded" },
      "body": { "$value": 100 }
    }
  },

  "type": {
    "viewport": {
      "$type": "dimension",
      "$description": "Fluid sizes grow from the min viewport to the max viewport.",
      "min": { "$value": 360 },
      "max": { "$value": 1440 }
    },
    "scale": {
      "$type": "fluidType",
      "$description": "Seven text variants. Sizes in px at the min and max viewport; tracking in em.",
      "display-xl": { "$value": { "min": 44, "max": 96, "lineHeight": 0.98, "tracking": -0.02, "weight": "{font.weight.heavy}", "family": "display", "stretch": "{font.stretch.display}" } },
      "display": { "$value": { "min": 36, "max": 68, "lineHeight": 1.02, "tracking": -0.018, "weight": "{font.weight.heavy}", "family": "display", "stretch": "{font.stretch.display}" } },
      "h1": { "$value": { "min": 30, "max": 48, "lineHeight": 1.08, "tracking": -0.012, "weight": "{font.weight.heavy}", "family": "display", "stretch": "{font.stretch.display}" } },
      "h2": { "$value": { "min": 24, "max": 34, "lineHeight": 1.15, "tracking": -0.008, "weight": "{font.weight.bold}", "family": "display", "stretch": "{font.stretch.display}" } },
      "body-lg": { "$value": { "min": 18, "max": 21, "lineHeight": 1.5, "tracking": 0, "weight": "{font.weight.regular}", "family": "body", "stretch": "{font.stretch.body}" } },
      "body": { "$value": { "min": 16, "max": 18, "lineHeight": 1.6, "tracking": 0, "weight": "{font.weight.regular}", "family": "body", "stretch": "{font.stretch.body}" } },
      "small": { "$value": { "min": 14, "max": 15, "lineHeight": 1.5, "tracking": 0, "weight": "{font.weight.regular}", "family": "body", "stretch": "{font.stretch.body}" } }
    },
    "latin": {
      "locales": { "$type": "list", "$value": ["en"], "$description": "Locales set in the Latin display and body fonts" }
    },
    "devanagari": {
      "$type": "number",
      "$description": "Hindi and Marathi need taller lines for matras and zero letter-spacing so the headline (shirorekha) stays joined.",
      "locales": { "$type": "list", "$value": ["hi", "mr"], "$description": "Locales set in the Devanagari fonts" },
      "lineHeight": {
        "display-xl": { "$value": 1.24 },
        "display": { "$value": 1.28 },
        "h1": { "$value": 1.3 },
        "h2": { "$value": 1.36 },
        "body-lg": { "$value": 1.72 },
        "body": { "$value": 1.78 },
        "small": { "$value": 1.7 }
      },
      "weight": {
        "display-xl": { "$value": "{font.weight.heavy}" },
        "display": { "$value": "{font.weight.heavy}" },
        "h1": { "$value": "{font.weight.heavy}" },
        "h2": { "$value": "{font.weight.bold}" },
        "body-lg": { "$value": "{font.weight.regular}" },
        "body": { "$value": "{font.weight.regular}" },
        "small": { "$value": "{font.weight.regular}" }
      }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "4px base scale in px (emitted as rem).",
    "1": { "$value": 4 },
    "2": { "$value": 8 },
    "3": { "$value": 12 },
    "4": { "$value": 16 },
    "5": { "$value": 24 },
    "6": { "$value": 32 },
    "7": { "$value": 48 },
    "8": { "$value": 64 },
    "9": { "$value": 96 },
    "10": { "$value": 128 },
    "fluid": {
      "$type": "fluidDimension",
      "gutter": { "$value": { "min": 16, "max": 40 }, "$description": "Side padding of the page" },
      "stack": { "$value": { "min": 24, "max": 40 }, "$description": "Gap between blocks in a section" },
      "section": { "$value": { "min": 32, "max": 80 }, "$description": "Padding above and below each section, so the gap between two sections is twice this" }
    }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": 0 },
    "sm": { "$value": 6 },
    "md": { "$value": 12 },
    "lg": { "$value": 20 },
    "xl": { "$value": 32 },
    "round": { "$value": 9999 }
  },

  "layout": {
    "measure": { "$type": "string", "$value": "68ch", "$description": "Line length for English text" },
    "measure-devanagari": { "$type": "string", "$value": "74ch" },
    "container": { "$type": "dimension", "$value": 1240 },
    "container-wide": { "$type": "dimension", "$value": 1440 },
    "column-min": { "$type": "dimension", "$value": 340, "$description": "Narrowest a column of a two-column section gets before the columns stack" },
    "pin-short": { "$type": "string", "$value": "200vh", "$description": "Scroll length of a short pinned section (one viewport of scrolling while it holds still)" },
    "pin-long": { "$type": "string", "$value": "320vh", "$description": "Scroll length of a pinned section that steps through several states" },
    "pin-from": { "$type": "string", "$value": "md", "$description": "Pinned sections pin at every width. From this breakpoint the text and the visual hold still side by side; below it the text scrolls past first and only the visual holds still." }
  },

  "nav": {
    "$description": "The site header (docs/design/navigation.md). The tint and the blur are strongest at the top and fade out to nothing at the bottom of the faded layer, so the page slides under the header with no line.",
    "height": { "$type": "dimension", "$value": 72, "$description": "The bar that holds the links" },
    "extent": { "$type": "dimension", "$value": 120, "$description": "The faded layer, from the top of the screen" },
    "tint": { "$type": "string", "$value": "94%", "$description": "Share of the surface colour in the tint at its strongest (color-mix)" },
    "fade-start": { "$type": "string", "$value": "50%", "$description": "Where the tint and the blur start to fade, down the faded layer" },
    "blur": { "$type": "dimension", "$value": 14, "$description": "Backdrop blur at its strongest" },
    "menu-from": { "$type": "string", "$value": "xl", "$description": "The breakpoint from which the links show in the bar; below it they fold into the menu" }
  },

  "ghost": {
    "$description": "Controls that float over the page (the autoscroll toggle). At rest they are a faint tint of the raised surface, so they do not compete with the content; hover, focus and press make them solid.",
    "tint": { "$type": "string", "$value": "30%", "$description": "Share of the raised surface colour at rest (color-mix); the rest is transparent" },
    "blur": { "$type": "dimension", "$value": 8, "$description": "Backdrop blur at rest, so the label stays legible over busy content" }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "Exported to TypeScript and Python. CSS gets generated utility classes from them (breakpoints.css): .from-{name} hides an element below the breakpoint, .below-{name} from it, and .nav-wide and .nav-narrow follow nav.menu-from.",
    "sm": { "$value": 480 },
    "md": { "$value": 768 },
    "lg": { "$value": 1024 },
    "xl": { "$value": 1280 }
  },

  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "sticky": { "$value": 40 },
    "nav": { "$value": 50 },
    "overlay": { "$value": 80 },
    "dialog": { "$value": 90 },
    "toast": { "$value": 100 }
  },

  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "enter": { "$value": [0.2, 0.8, 0.2, 1], "$description": "Things arrive with weight and settle. No bounce." },
      "scrub": { "$value": [0.37, 0, 0.63, 1], "$description": "Scroll-linked movement" }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": 160 },
      "base": { "$value": 320 },
      "slow": { "$value": 700 }
    },
    "autoscroll": {
      "$type": "number",
      "$description": "Pinned 3D and animation sections keep moving in the reader's direction after a pause.",
      "pauseMs": { "$value": 500 },
      "rampMs": { "$value": 300 },
      "velocityWindowMs": { "$value": 250 },
      "minSpeed": { "$value": 0.35, "$description": "Viewport heights per second. A long pinned section (pin-long) then takes about 6 seconds at the slowest." },
      "maxSpeed": { "$value": 2.0, "$description": "Viewport heights per second" }
    }
  },

  "icon": {
    "size": {
      "$type": "dimension",
      "sm": { "$value": 16 },
      "md": { "$value": 20 },
      "lg": { "$value": 24 },
      "xl": { "$value": 32 }
    },
    "stroke": { "$type": "number", "$value": 1.75 }
  },

  "material": {
    "$type": "material",
    "$description": "three.js material settings for the 3D scenes. The medal-* materials come from the v3.2 medal (resources/dsap-iitjeekota-v3.2/js/scene.js): the official logo as the face texture with its normal map, lit as metal.",
    "medal-face": { "$value": { "color": "{color.chalk.0}", "metalness": 0.78, "roughness": 0.42, "normalScale": 1.4, "envMapIntensity": 1.3 }, "$description": "Front: map = media slot brand/logo-medal, normalMap = brand/logo-medal-normal" },
    "medal-back": { "$value": { "color": "{color.brass.200}", "metalness": 0.78, "roughness": 0.5, "normalScale": -1.4, "envMapIntensity": 1.1 }, "$description": "Back: the face texture mirrored and tinted" },
    "medal-edge": { "$value": { "color": "{color.brass.300}", "metalness": 1, "roughness": 0.3, "bumpScale": 1.2, "envMapIntensity": 1.4 }, "$description": "Reeded edge" },
    "medal-rim": { "$value": { "color": "{color.brass.300}", "metalness": 1, "roughness": 0.25 } },
    "brass": { "$value": { "color": "{color.brass.400}", "metalness": 1, "roughness": 0.34 } },
    "brass-polished": { "$value": { "color": "{color.brass.300}", "metalness": 1, "roughness": 0.18 } },
    "stone": { "$value": { "color": "{color.stone.500}", "metalness": 0, "roughness": 0.86 } },
    "stone-dark": { "$value": { "color": "{color.ink.800}", "metalness": 0, "roughness": 0.9 } },
    "chalk": { "$value": { "color": "{color.chalk.100}", "metalness": 0, "roughness": 0.7 } },
    "glass": { "$value": { "color": "{color.chalk.50}", "metalness": 0, "roughness": 0.06, "opacity": 0.08, "envMapIntensity": 0.2 }, "$description": "Display-case glass: see-through, with a faint sheen. Not refractive: the 3D canvases are transparent over the page, and refraction cannot see the page behind them." },
    "plate": { "$value": { "color": "{color.chalk.0}", "metalness": 0.4, "roughness": 0.45, "envMapIntensity": 1.1 }, "$description": "Engraved brass plates: half metal, so the engraving reads in any light. The brass colour comes from the plate texture." },
    "river": { "$value": { "color": "{color.river.500}", "metalness": 0.1, "roughness": 0.3, "emissive": "{color.river.300}", "emissiveIntensity": 0.35 } }
  },

  "scene": {
    "$type": "color",
    "fog": { "$value": "{color.ink.900}" },
    "light-key": { "$value": "{color.chalk.50}" },
    "light-rim": { "$value": "{color.brass.300}" }
  }
}
