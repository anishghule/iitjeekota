{
  "$page": "home",
  "$locale": "en",
  "$description": "Home page (/en/, the target of the root redirect). Organization and WebSite live here only. {{fact:...}} values are filled from facts.json; a property whose fact is pending is left out.",
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": "{{origin}}/#organization",
      "name": "D-SAP Ghule Tutorials",
      "alternateName": ["D-SAP", "D-SAP Ghule Tutorials, powered by Kota"],
      "url": "{{origin}}/",
      "logo": { "@type": "ImageObject", "url": "{{origin}}/brand/medal-512.png", "width": 512, "height": 512 },
      "description": "IIT JEE coaching in Pune and Pimpri-Chinchwad, powered by a Kota institute, with centres in New Sangvi and Wakad.",
      "telephone": "{{fact:contact.phone}}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Krishna Nagar Rd Number 2, Krishna Nagar",
        "addressLocality": "New Sangvi, Pimpri-Chinchwad",
        "addressRegion": "Maharashtra",
        "postalCode": "411061",
        "addressCountry": "IN"
      },
      "contactPoint": {
        "$onlyIfConfirmed": ["contact.phone"],
        "@type": "ContactPoint",
        "telephone": "{{fact:contact.phone}}",
        "contactType": "admissions",
        "availableLanguage": ["English", "Hindi", "Marathi"]
      },
      "sameAs": "{{fact:org.same-as}}",
      "foundingDate": "{{fact:org.founded#year}}",
      "founder": { "@type": "Person", "name": "{{fact:org.founder#name}}", "url": "{{origin}}/en/about/#prof-ghule" },
      "department": [
        { "@id": "{{origin}}/en/centres/sangvi-head-office/#centre" },
        { "@id": "{{origin}}/en/centres/wakad/#centre" }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "{{origin}}/#website",
      "name": "D-SAP Ghule Tutorials",
      "alternateName": ["D-SAP", "iitjeekota.com"],
      "url": "{{origin}}/",
      "inLanguage": ["en-IN", "hi-IN", "mr-IN"],
      "publisher": { "@id": "{{origin}}/#organization" }
    }
  ]
}
