{
  "$page": "centre-wakad",
  "$locale": "en",
  "$description": "A centre page: the LocalBusiness for that centre, which its Google Business Profile links to.",
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "EducationalOrganization"],
      "@id": "{{origin}}/en/centres/wakad/#centre",
      "priceRange": "{{fact:fees.range}}",
      "name": "D-SAP Ghule Tutorials, Wakad",
      "url": "{{origin}}/en/centres/wakad/",
      "image": "{{origin}}/brand/medal-512.png",
      "telephone": "{{fact:contact.phone}}",
      "hasMap": "{{fact:centre.wakad.maps}}",
      "geo": {
        "$onlyIfConfirmed": ["centre.wakad.geo"],
        "@type": "GeoCoordinates",
        "latitude": "{{fact:centre.wakad.geo#latitude}}",
        "longitude": "{{fact:centre.wakad.geo#longitude}}"
      },
      "openingHoursSpecification": "{{fact:centre.wakad.hours}}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "First floor, Shiv Malhar, Swami Vivekanand Nagar",
        "addressLocality": "Wakad, Pimpri-Chinchwad",
        "addressRegion": "Maharashtra",
        "postalCode": "411057",
        "addressCountry": "IN"
      },
      "parentOrganization": { "@id": "{{origin}}/#organization" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{origin}}/en/" },
        { "@type": "ListItem", "position": 2, "name": "Centres", "item": "{{origin}}/en/centres/" },
        { "@type": "ListItem", "position": 3, "name": "D-SAP Ghule Tutorials, Wakad" }
      ]
    }
  ]
}
