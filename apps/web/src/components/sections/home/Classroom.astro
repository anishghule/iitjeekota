---
/**
 * A class, as it happens (plan C1 5): a real class filmed upright, played with a Play and Pause
 * button. The section does not pin, and scrolling never moves the film (components/ui/FilmPlayer.astro).
 */
import { mediaFile } from "../../../lib/data.ts";
import type { Locale } from "../../../i18n/index.ts";
import type { SectionData } from "../../../lib/types.ts";
import FilmPlayer from "../../ui/FilmPlayer.astro";
import Paragraphs from "../../ui/Paragraphs.astro";

interface Props {
  section: SectionData;
  locale: Locale;
}
const { section, locale } = Astro.props;
const film = mediaFile("home/classroom-film", locale);
const poster = mediaFile("home/classroom-film-poster", locale);
---
{film && (
  <section id={section.id} class="classroom section" aria-labelledby={`${section.id}-title`}>
    <div class="container split">
      <div class="classroom__text">
        <h2 id={`${section.id}-title`} class="t-display">{section.heading}</h2>
        <Paragraphs paragraphs={section.body} class="lede" />
      </div>
      <FilmPlayer film={film} poster={poster} locale={locale} />
    </div>
  </section>
)}

<style>
  .classroom__text { display: grid; gap: var(--space-5); }
</style>
