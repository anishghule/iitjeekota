---
/**
 * Where we teach (plan C4): the area map from packages/map (OpenStreetMap, built by make map) with
 * both centres, the two rivers unnamed, and each area's route to its nearer centre. Picking an area
 * shows its confirmed commute and links to its page when that page is live.
 */
import { fill, strings, type Locale } from "../../../i18n/index.ts";
import { areaMap, isRouteId, localName, routePath, site } from "../../../lib/data.ts";
import type { SectionData } from "../../../lib/types.ts";
import ActionLink from "../../ui/ActionLink.astro";
import Paragraphs from "../../ui/Paragraphs.astro";

interface Props {
  section: SectionData;
  locale: Locale;
}
const { section, locale } = Astro.props;
const t = strings(locale);
const centres = new Map(site.centres.map((c) => [c.id, c]));
const points = new Map(areaMap.areas.map((a) => [a.id, a]));
const routes = new Map(areaMap.routes.map((r) => [r.area, r]));
const areas = site.areas.filter((a) => points.has(a.id));
const [, , width, height] = areaMap.viewBox;
// Sizes in map units from packages/map/map.json (style); colours come from the surface roles below.
const s = areaMap.style;
const gap = s.area * 2;

const card = (area: (typeof areas)[number]) => {
  const name = localName(area.names, locale);
  const centre = centres.get(area.localCentre ?? area.nearestCentre);
  const centreName = centre ? localName(centre.places, locale) : "";
  const commute: { km?: number; freeFlowMinutes?: number; minutes?: number[] } | null = area.commute;
  const page = area.page && isRouteId(area.page) ? routePath(area.page, locale) : undefined;
  const minutes = commute?.minutes?.length === 2
    ? fill(t.areaMap.range, { from: commute.minutes[0] ?? "", to: commute.minutes[1] ?? "" })
    : commute?.freeFlowMinutes !== undefined ? fill(t.areaMap.freeFlow, { min: commute.freeFlowMinutes }) : undefined;
  return { name, centreName, centre, commute, page, minutes };
};
---
<section id={section.id} class="area-map section" data-area-map aria-labelledby={`${section.id}-title`}>
  <div class="container split area-map__grid">
    <div class="area-map__text">
      <h2 id={`${section.id}-title`} class="t-display">{section.heading}</h2>
      <Paragraphs paragraphs={section.body} class="lede" />
      <div class="chips" role="group" aria-label={t.areaMap.pick}>
        {areas.map((a) => <button type="button" class="chip" data-pick={a.id} aria-pressed="false">{localName(a.names, locale)}</button>)}
      </div>
      {areas.map((a) => {
        const c = card(a);
        return (
          <div class="area-card card" data-card={a.id} hidden>
            {a.localCentre ? (
              <p class="t-h2">{fill(t.areaMap.inArea, { centre: c.centreName, area: c.name })}</p>
            ) : (
              <>
                <p class="muted">{fill(t.areaMap.toCentre, { area: c.name, centre: c.centreName })}</p>
                {c.commute?.km !== undefined && <p class="t-h1 accent tabular">{fill(t.areaMap.km, { km: c.commute.km })}</p>}
                {c.minutes && <p>{c.minutes}</p>}
              </>
            )}
            <p class="area-card__links">
              {c.page && <a href={c.page}>{fill(t.areaMap.page, { area: c.name })}</a>}
              {c.centre?.directions && <a href={c.centre.directions} rel="external">{fill(t.areaMap.directions, { centre: c.centreName })}</a>}
            </p>
          </div>
        );
      })}
      {section.action && <div class="actions"><ActionLink action={section.action} locale={locale} quiet /></div>}
    </div>
    <figure class="area-map__figure">
      <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={t.areaMap.map}>
        <g class="roads">
          {areaMap.roads.map((r) => <path d={r.d} stroke-width={r.kind === "primary" ? s.road.primary : s.road.major} />)}
        </g>
        <g class="rivers" stroke-width={s.river}>{areaMap.rivers.map((d) => <path d={d} />)}</g>
        <g class="routes" stroke-width={s.route} stroke-dasharray={s.routeDash}>
          {areaMap.routes.map((r) => <path d={r.d} data-area={r.area} />)}
        </g>
        <g class="points" font-size={s.label}>
          {areaMap.areas.filter((p) => !p.centre).map((p) => (
            <g data-area={p.id}>
              <circle cx={p.x} cy={p.y} r={s.area} />
              <text x={p.x + gap} y={p.y + s.area}>{localName(site.areas.find((a) => a.id === p.id)?.names ?? {}, locale)}</text>
            </g>
          ))}
        </g>
        <g class="centres" font-size={s.centreLabel} stroke-width={s.centreRing}>
          {areaMap.centres.map((c) => (
            <g data-area={centres.get(c.id)?.area}>
              <circle cx={c.x} cy={c.y} r={s.centre} />
              <text x={c.x + s.centre + gap / 2} y={c.y - s.centre}>{localName(centres.get(c.id)?.places ?? {}, locale)}</text>
            </g>
          ))}
        </g>
      </svg>
      <figcaption class="muted">{areaMap.attribution}</figcaption>
    </figure>
  </div>
</section>

<style>
  .area-map__grid { align-items: start; }
  .area-map__text { display: grid; gap: var(--space-5); }
  .area-card { display: grid; gap: var(--space-2); }
  .area-card__links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .area-map__figure { margin: 0; display: grid; gap: var(--space-2); }
  .area-map__figure svg { width: 100%; height: auto; border-radius: var(--radius-lg); background: var(--bg-sunken); box-shadow: var(--shadow-2); }
  .area-map__figure figcaption { font-size: var(--type-small-size); text-align: end; }
  .roads path { fill: none; stroke: var(--bg-raised); stroke-linecap: round; }
  .rivers path { fill: none; stroke: var(--river); stroke-linecap: round; stroke-linejoin: round; }
  .routes path {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-enter);
  }
  .routes path[data-active] { opacity: 1; }
  .points circle { fill: var(--text-muted); transition: fill var(--dur-base) var(--ease-enter); }
  .points text, .centres text { fill: var(--text-muted); font-family: var(--font-body); }
  .points [data-active] circle { fill: var(--text); }
  .points [data-active] text { fill: var(--text); font-weight: var(--weight-semibold); }
  .centres circle { fill: var(--action-bg); stroke: var(--accent); }
  .centres text { fill: var(--accent-text); font-weight: var(--weight-bold); }
</style>
