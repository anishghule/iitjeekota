---
/** Finding a centre: the section's words, then the centre's card (components/ui/CentreDetails.astro). */
import type { Locale } from "../../i18n/index.ts";
import { centreOfRoute } from "../../lib/data.ts";
import type { SectionData } from "../../lib/types.ts";
import CentreDetails from "../ui/CentreDetails.astro";
import Paragraphs from "../ui/Paragraphs.astro";

interface Props {
  section: SectionData;
  locale: Locale;
  route: string;
}
const { section, locale, route } = Astro.props;
const centre = centreOfRoute(route);
---
<section id={section.id} class="section" aria-labelledby={`${section.id}-title`}>
  <div class="container split centre">
    <div class="centre__text">
      <h2 id={`${section.id}-title`} class="t-h1">{section.heading}</h2>
      <Paragraphs paragraphs={section.body} />
    </div>
    {centre && <CentreDetails centre={centre} locale={locale} />}
  </div>
</section>

<style>
  .centre { align-items: start; }
  .centre__text { display: grid; gap: var(--space-4); }
</style>
