---
/** How the tests run: the section's words, then each kind of test as a numbered step. */
import type { Locale } from "../../i18n/index.ts";
import type { SectionData } from "../../lib/types.ts";
import ActionLink from "../ui/ActionLink.astro";
import Paragraphs from "../ui/Paragraphs.astro";
import Rich from "../ui/Rich.astro";

interface Props {
  section: SectionData;
  locale: Locale;
}
const { section, locale } = Astro.props;
---
<section id={section.id} class="section" aria-labelledby={`${section.id}-title`}>
  <div class="container prose">
    <h2 id={`${section.id}-title`} class="t-h1">{section.heading}</h2>
    <Paragraphs paragraphs={section.body} />
    {section.points && (
      <ol class="plan" role="list">
        {section.points.map((p) => <li class="plan__step"><Rich parts={p} /></li>)}
      </ol>
    )}
    {section.action && <div class="actions"><ActionLink action={section.action} locale={locale} quiet /></div>}
  </div>
</section>

<style>
  .plan { display: grid; gap: var(--space-3); counter-reset: plan; }
  .plan__step { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: baseline; counter-increment: plan; }
  .plan__step::before {
    content: counter(plan, decimal-leading-zero);
    font-family: var(--font-display);
    font-weight: var(--weight-heavy);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
</style>
