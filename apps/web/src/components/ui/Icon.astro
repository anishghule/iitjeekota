---
/** An icon from the sprite (packages/icons), by its typed name. Decorative unless given a label. */
import type { IconName } from "@dsap/icons";

interface Props {
  name: IconName;
  size?: "sm" | "md" | "lg" | "xl";
  label?: string;
  class?: string;
}
const { name, size = "md", label, class: extra } = Astro.props;
---
<svg class:list={["icon", `icon--${size}`, extra]} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"} focusable="false">
  <use href={`#i-${name}`}></use>
</svg>
