---
/** Resolved copy: plain runs, bold runs, and links to live pages (make web-data decides which are links). */
import type { Rich } from "../../lib/types.ts";

interface Props {
  parts: Rich;
}
const { parts } = Astro.props;
---
{parts.map((part) => {
  const text = part.strong ? <strong>{part.text}</strong> : part.text;
  return part.path ? <a href={part.path}>{text}</a> : text;
})}
